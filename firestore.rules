          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(reviewId)
          && isValidReview(incoming(), userId, reviewId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && !('createdAt' in incoming().diff(existing()).affectedKeys())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'reviewType', 'title', 'periodStart', 'periodEnd', 'strategyName',
            'summary', 'tradingMistakes', 'lessonsLearned', 'behaviouralPatterns',
            'improvementGoals', 'rating', 'sourceUpdatedAt', 'unknownFields', 'updatedAt'
