      match /instruments/{instrumentId} {
        allow get: if isOwner(userId) && isValidId(instrumentId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(instrumentId)
          && isValidInstrument(incoming(), userId, instrumentId)
          && parentUserExists(userId)
