      match /reviews/{reviewId} {
        allow get: if isOwner(userId) && isValidId(reviewId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(reviewId)
          && isValidReview(incoming(), userId, reviewId)
          && parentUserExists(userId)
