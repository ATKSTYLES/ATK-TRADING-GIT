        allow update: if isOwner(userId)
          && isValidId(groupId)
          && isValidTradeGroup(incoming(), userId, groupId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && !('createdAt' in incoming().diff(existing()).affectedKeys())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'date', 'sourceUpdatedAt', 'unknownFields', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(groupId);
      }

      match /attachments/{attachmentId} {
        allow get: if isOwner(userId) && isValidId(attachmentId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(attachmentId)
          && isValidAttachment(incoming(), userId, attachmentId)
          && parentUserExists(userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(attachmentId);
      }

      match /session_templates/{templateId} {
        allow get: if isOwner(userId) && isValidId(templateId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(templateId)
          && isValidSessionTemplate(incoming(), userId, templateId)
