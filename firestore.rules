          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && !('createdAt' in incoming().diff(existing()).affectedKeys())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'market', 'plannedStartTime', 'plannedEndTime', 'timezone',
            'defaultChecklist', 'notes', 'unknownFields', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(templateId);
      }

      match /checklists/{checklistId} {
        allow get: if isOwner(userId) && isValidId(checklistId);
