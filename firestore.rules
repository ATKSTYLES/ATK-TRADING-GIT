      match /audit_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(logId)
          && isValidAuditLog(incoming(), userId, logId)
          && parentUserExists(userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
