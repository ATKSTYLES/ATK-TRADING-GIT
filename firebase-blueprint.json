  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile document."
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/TradingAccount" },
      "description": "Personal trading accounts belonging to the user."
    },
    "/users/{userId}/daily_journals/{journalId}": {
      "schema": { "$ref": "#/entities/DailyJournal" },
      "description": "Day-level journal records belonging to the user."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TradingSession" },
      "description": "Trading sessions belonging to the user."
    },
    "/users/{userId}/session_events/{eventId}": {
      "schema": { "$ref": "#/entities/SessionEvent" },
      "description": "Session event timeline entries belonging to the user."
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Trade records belonging to the user."
    },
    "/users/{userId}/trade_events/{eventId}": {
      "schema": { "$ref": "#/entities/TradeEvent" },
      "description": "Trade event timeline entries belonging to the user."
    },
    "/users/{userId}/trade_groups/{groupId}": {
      "schema": { "$ref": "#/entities/TradeGroup" },
      "description": "Trade group records belonging to the user."
    },
    "/users/{userId}/attachments/{attachmentId}": {
      "schema": { "$ref": "#/entities/Attachment" },
      "description": "Private screenshots and chart attachments belonging to the user."
    },
    "/users/{userId}/session_templates/{templateId}": {
      "schema": { "$ref": "#/entities/SessionTemplate" },
      "description": "Configured session templates belonging to the user."
    },
    "/users/{userId}/checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/Checklist" },
      "description": "Configurable checklist templates belonging to the user."
    },
    "/users/{userId}/instruments/{instrumentId}": {
      "schema": { "$ref": "#/entities/Instrument" },
      "description": "Configured tradable instruments belonging to the user."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "User preferences and logger configuration."
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Structured daily, weekly, monthly, and strategy reviews."
    },
    "/users/{userId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit logs for export, import, and recovery actions."
    }
  }
