      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "timezone": { "type": "string", "maxLength": 80 },
        "currency": { "type": "string", "maxLength": 12 },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "sourceApplication": { "type": "string", "maxLength": 80 },
        "sourceCreatedAt": { "type": "string", "maxLength": 64 },
        "sourceUpdatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "email", "displayName", "timezone", "currency", "theme", "createdAt", "updatedAt"]
    },
