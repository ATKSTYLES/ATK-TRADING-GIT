        "mistakes": { "type": "array" },
        "lessons": { "type": "string", "maxLength": 4000 },
        "disciplineQuestions": { "type": "object" },
        "attachmentIds": { "type": "array" },
        "sourceApplication": { "type": "string", "maxLength": 80 },
        "sourceCreatedAt": { "type": "string", "maxLength": 64 },
